# Bharat Yatra — Environment Variables
# Copy this file to .env at the repository root and adjust values for local development.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Bharat Yatra
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.2:5173

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=bharatyatra
POSTGRES_PASSWORD=bharatyatra_dev_password
POSTGRES_DB=bharatyatra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Local without Docker:
DATABASE_URL=sqlite:///./bharatyatra.db
# With Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://bharatyatra:bharatyatra_dev_password@localhost:5432/bharatyatra

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Bharat Yatra
VITE_MAP_PROVIDER=leaflet

# -----------------------------------------------------------------------------
# AI (placeholders — Phase 9+)
# -----------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2048
AI_REQUEST_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Payments (placeholders — Phase 17)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# -----------------------------------------------------------------------------
# Notifications (placeholders — Phase 20)
# -----------------------------------------------------------------------------
NOTIFICATION_PROVIDER=in_app

# -----------------------------------------------------------------------------
# OTP / Auth
# -----------------------------------------------------------------------------
OTP_PROVIDER=mock
OTP_EXPIRE_MINUTES=10
OTP_DEBUG_EXPOSE_CODE=true

# -----------------------------------------------------------------------------
# Production hardening (Phase 25)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
SECURITY_HEADERS_ENABLED=true
TRUSTED_HOSTS=*
